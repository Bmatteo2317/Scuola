# Stringa di connessione Neon (Dashboard Neon -> Connect -> la tua connection string)
DATABASE_URL="postgresql://utente:password@ep-xxxx-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Segreto per firmare il cookie di sessione: almeno 16 caratteri casuali
AUTH_SECRET="cambia-questa-stringa-con-una-casuale-lunga"
